---
import { type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const es = locale === 'es';
---

<figure class="depth-map not-prose my-8">
  <div class="map-frame rounded-lg overflow-hidden border relative" style="height:60vh; border-color: var(--rule)">
    <div id="pa-map" style="position:absolute; inset:0;" role="application" aria-label={es ? 'Mapa de áreas protegidas' : 'Protected areas map'}></div>

    <noscript>
      <div class="absolute inset-0 grid place-items-center p-6 text-center text-sm" style="background: var(--surface-raised)">
        {es
          ? 'El mapa interactivo necesita JavaScript. Los datos están disponibles en site/public/data/protected-areas.geojson.'
          : 'The interactive map needs JavaScript. The data is available at site/public/data/protected-areas.geojson.'}
      </div>
    </noscript>

    <div class="map-panel absolute top-3 left-3 rounded-md border shadow-sm p-3 text-xs max-w-[15rem] space-y-1.5"
         style="background: var(--surface-raised); border-color: var(--rule)">
      <div class="flex items-center gap-2">
        <span class="inline-block w-3 h-3 rounded-sm" style="background: rgba(29,110,86,0.55)"></span>
        <span>{es ? 'Parque nacional' : 'National park'}</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="inline-block w-3 h-3 rounded-sm" style="background: rgba(74,149,199,0.55)"></span>
        <span>{es ? 'Refugio de vida silvestre' : 'Wildlife refuge'}</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="inline-block w-3 h-3 rounded-sm" style="background: rgba(217,164,65,0.55)"></span>
        <span>{es ? 'Reserva forestal' : 'Forest reserve'}</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="inline-block w-3 h-3 rounded-sm" style="background: rgba(153,86,161,0.55)"></span>
        <span>{es ? 'Humedal / Ramsar' : 'Wetland / Ramsar'}</span>
      </div>
    </div>

    <div id="pa-readout" class="map-panel absolute bottom-3 right-3 rounded-md border px-2.5 py-1.5 text-xs max-w-[16rem]"
         style="background: var(--surface-raised); border-color: var(--rule); color: var(--ink)" hidden></div>
  </div>
  <figcaption class="mt-2 text-xs" style="color: var(--ink-muted)">
    {es
      ? 'Límites del WDPA (Base de Datos Mundial de Áreas Protegidas de UNEP-WCMC y UICN), simplificados para la web. Pase el cursor sobre un área para ver su nombre y año de designación. El Área Marina de Pesca Responsable Golfo Dulce — la designación que realmente cubre el agua del golfo — no aparece: es un instrumento de INCOPESCA, no una categoría UICN, y no se encontró un límite público para ella.'
      : "Boundaries from the WDPA (World Database on Protected Areas, UNEP-WCMC and IUCN), simplified for the web. Hover an area for its name and designation year. The Área Marina de Pesca Responsable Golfo Dulce — the designation that actually covers the gulf's own water — does not appear: it is an INCOPESCA instrument, not an IUCN category, and no public boundary for it could be found."}
  </figcaption>
</figure>

<script>
  // maplibre-gl v6 ships named exports only — there is no default export.
  import { Map as MapLibreMap, NavigationControl } from 'maplibre-gl';
  import 'maplibre-gl/dist/maplibre-gl.css';

  const el = document.getElementById('pa-map');
  if (el) {
    const dark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    const bg = dark ? '#0d1a26' : '#f3f1ea';
    const line = dark ? '#233444' : '#cfc7b8';

    const map = new MapLibreMap({
      container: 'pa-map',
      style: {
        version: 8,
        sources: {
          areas: { type: 'geojson', data: '/data/protected-areas.geojson' },
        },
        layers: [
          { id: 'bg', type: 'background', paint: { 'background-color': bg } },
          {
            id: 'areas-fill',
            type: 'fill',
            source: 'areas',
            paint: {
              'fill-color': [
                'match',
                ['get', 'desig_eng'],
                'National Park', 'rgba(29,110,86,0.55)',
                'National Wildlife Refuge', 'rgba(74,149,199,0.55)',
                'Forest Reserve', 'rgba(217,164,65,0.55)',
                'Wetland', 'rgba(153,86,161,0.55)',
                'Wetland of International Importance (Ramsar Site)', 'rgba(153,86,161,0.35)',
                'rgba(120,120,120,0.4)',
              ],
            },
          },
          { id: 'areas-outline', type: 'line', source: 'areas', paint: { 'line-color': line, 'line-width': 1 } },
        ],
      },
      bounds: [[-83.85, 8.32], [-83.05, 9.22]],
      fitBoundsOptions: { padding: 20 },
      attributionControl: { compact: true },
    });

    map.addControl(new NavigationControl({ showCompass: false }), 'top-right');

    const readout = document.getElementById('pa-readout');
    map.on('mousemove', (ev) => {
      const features = map.queryRenderedFeatures(ev.point, { layers: ['areas-fill'] });
      if (!readout) return;
      if (!features.length) {
        readout.hidden = true;
        return;
      }
      const p = features[0].properties as any;
      readout.hidden = false;
      readout.textContent = `${p.name} — ${p.desig_eng} (${p.status_yr})`;
    });
  }
</script>
