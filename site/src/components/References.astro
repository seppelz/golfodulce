---
import { getCollection } from 'astro:content';
import { useTranslations, type Locale } from '../i18n/ui';

interface Props {
  /** Ordered source ids, as produced by remark-citations (order of first appearance). */
  citations: string[];
  locale: Locale;
}

const { citations, locale } = Astro.props;
const t = useTranslations(locale);

const sources = await getCollection('sources');
const byId = new Map(sources.map((s) => [s.data.id, s.data]));

const ACCESS_LABEL: Record<string, string> = {
  open: t('sources.open'),
  paywalled: t('sources.paywalled'),
  'request-required': t('sources.request'),
  unknown: t('sources.unknown'),
};

function authorsShort(authors: string[]): string {
  if (authors.length === 1) return authors[0];
  if (authors.length === 2) return `${authors[0]} & ${authors[1]}`;
  return `${authors[0]} et al.`;
}
---

<section class="references not-prose mt-16 pt-8 border-t" style="border-color: var(--rule)" aria-label={t('refs.heading')}>
  <h2 class="text-sm font-semibold uppercase tracking-wider mb-4" style="color: var(--ink-muted)">
    {t('refs.heading')}
  </h2>

  {citations.length === 0 ? (
    <p class="text-sm" style="color: var(--ink-muted)">{t('refs.empty')}</p>
  ) : (
    <ol class="space-y-3 text-sm">
      {citations.map((id, i) => {
        const s = byId.get(id);
        if (!s) return null;
        const href = s.doi ? `https://doi.org/${s.doi}` : s.url;
        return (
          <li id={`ref-${id}`} class="reference flex gap-3 scroll-mt-20 p-1.5 -m-1.5 rounded">
            <span class="tabular-nums shrink-0" style="color: var(--ink-muted)">{i + 1}.</span>
            <p>
              <a href={`#cite-${id}-${i + 1}`} class="text-xs mr-1.5 no-underline" style="color: var(--ink-muted)" aria-label="Back to text">&uarr;</a>
              <span class="font-medium">{authorsShort(s.authors)}</span>
              {s.year && <span> ({s.year})</span>}.{' '}
              {href ? (
                <a href={href} target="_blank" rel="noopener noreferrer">{s.title}</a>
              ) : (
                <span>{s.title}</span>
              )}
              {s.container && <span style="color: var(--ink-muted)">. {s.container}</span>}
              <span class="ml-2 text-xs px-1.5 py-0.5 rounded" style="background: color-mix(in srgb, var(--accent) 10%, transparent); color: var(--accent)">
                {ACCESS_LABEL[s.access]}
              </span>
              {s.caveat && (
                <span class="block mt-1 text-xs italic" style="color: var(--color-shoal-600)">{s.caveat}</span>
              )}
            </p>
          </li>
        );
      })}
    </ol>
  )}
</section>
