---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { useTranslations, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  title: string;
  description?: string;
  /** Path without locale prefix, e.g. "oceanography/anoxic-basin" — used for hreflang. */
  path?: string;
}

const { locale, title, description, path = '' } = Astro.props;
const t = useTranslations(locale);

const siteName = t('site.title');
const fullTitle = title === siteName ? `${siteName} — ${t('site.tagline')}` : `${title} · ${siteName}`;
const desc = description ?? t('site.description');
const canonical = new URL(`/${locale}${path ? '/' + path : ''}`, Astro.site);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />

    {/* Both languages are equal citizens; tell search engines so. */}
    <link rel="alternate" hreflang="en" href={new URL(`/en${path ? '/' + path : ''}`, Astro.site)} />
    <link rel="alternate" hreflang="es" href={new URL(`/es${path ? '/' + path : ''}`, Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(`/en${path ? '/' + path : ''}`, Astro.site)} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:locale" content={locale === 'es' ? 'es_CR' : 'en_GB'} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="sitemap" href="/sitemap-index.xml" />
    <slot name="head" />
  </head>

  <body class="min-h-screen flex flex-col">
    <a class="skip-link" href="#main">{t('skip')}</a>
    <SiteHeader locale={locale} path={path} />
    <main id="main" class="flex-1 w-full">
      <slot />
    </main>
    <SiteFooter locale={locale} />
  </body>
</html>
